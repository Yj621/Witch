    <ui:GroupBox name="GroupBox" style="flex-grow: 1; max-width: 150px; margin-top: 5px; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; align-items: center;">
        <ui:GroupBox name="GroupBox" style="flex-direction: row; justify-content: space-around; align-items: flex-end; flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 2px; padding-bottom: 0; padding-left: 2px; border-bottom-color: rgba(0, 0, 0, 0.59); border-bottom-width: 1px;">
            <ui:VisualElement name="ActiveTime" style="flex-grow: 1;">
                <Style src="project://database/Assets/Plugins/Tiny%20Giant%20Studio/DevTools/DevTrails/Scripts/Editor/Style%20Sheet/DevTrailsIcons.uss?fileID=7433441132597879392&amp;guid=b982efd273f426b4ca61d206c6f7ac92&amp;type=3#DevTrailsIcons" />
