        <ui:Label tabindex="-1" text="Label" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Label" style="-unity-text-align: upper-center; padding-top: 5px; padding-right: 0; padding-bottom: 5px; padding-left: 0; white-space: nowrap; height: 50px; flex-shrink: 1; overflow: hidden;" />
